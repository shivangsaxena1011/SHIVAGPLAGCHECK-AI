# OriginalityGuard AI Environment Configuration

# Server & Security
PORT=8000
HOST=0.0.0.0
DEBUG=False
SECRET_KEY=change_this_to_a_secure_random_string_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# PostgreSQL with pgvector recommended for production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/originalityguard
# SQLite for lightweight local/desktop offline usage:
DATABASE_URL=sqlite+aiosqlite:///./originalityguard.db

# Storage Directories
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
CORPUS_DIR=./storage/corpus
MODEL_CACHE_DIR=./storage/models

# Semantic Embeddings & NLP
SBERT_MODEL=paraphrase-MiniLM-L6-v2
SBERT_DEVICE=cpu
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Academic API Integrations (Free / Polite Pool)
CROSSREF_API_EMAIL=user@institution.edu
OPENALEX_EMAIL=user@institution.edu
SEMANTIC_SCHOLAR_API_KEY=

# Optional LLM Verification Keys (Not required for core similarity/AI detection)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Redis / Background Worker (Optional)
REDIS_URL=redis://localhost:6379/0
