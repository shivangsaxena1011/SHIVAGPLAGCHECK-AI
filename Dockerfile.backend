# Production Dockerfile for SHIVANG PLAGCHECK AI Backend
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for build and document processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend codebase and CLI packages
COPY backend/ /app/
COPY originalguard/ /app/originalguard/
COPY plagcheck/ /app/plagcheck/
COPY shivangplagcheck/ /app/shivangplagcheck/
COPY tests/fixtures/ /app/tests/fixtures/

# Create data and storage directories
RUN mkdir -p /app/data /app/storage

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PORT=8000
ENV HOST=0.0.0.0

EXPOSE 8000

# Start FastAPI application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
